 # ======================================================================================================
+# PERF helpers (frame handling only; none of this touches the detector)
+# ======================================================================================================
+class _ProcResizer:
+    """INTER_AREA resize of a source frame to the processing size, computing ONLY the ROI rows/cols that process() reads
+    (it only ever slices frame[y0:y1, x0:x1]).  With an integer source->processing scale k, INTER_AREA is a k x k box average and
+    every output pixel depends only on its own k x k block, so the ROI-only result is bit-identical to the full resize (checked on the
+    first frame by self_check(); any mismatch, or a non-integer scale, silently falls back to the full resize).
+    NOTE: in fast mode the rows outside the ROI of the returned buffer are ZERO and the buffer is reused for the next frame.  Code that
+    needs the whole processing-size frame (e.g. a future vehicle detector) should call .full(frame) or construct with enabled=False."""
+
+    def __init__(self, det, sw, sh, pw, ph, enabled=True):
+        self.pw, self.ph, self.fast = pw, ph, False
+        if enabled and sw % pw == 0 and sh == ph * (sw // pw):
+            y0, y1, x0, x1 = det.y0, det.y1, det.x0, det.x1
+            if 0 <= y0 < y1 <= ph and 0 <= x0 < x1 <= pw:
+                self.k, self.roi, self.fast = sw // pw, (y0, y1, x0, x1), True
+                self.buf = np.zeros((ph, pw, 3), np.uint8)
+
+    def full(self, f):
+        return cv2.resize(f, (self.pw, self.ph), interpolation=cv2.INTER_AREA)
+
+    def __call__(self, f):
+        if not self.fast:
+            return self.full(f)
+        k, (y0, y1, x0, x1) = self.k, self.roi
+        self.buf[y0:y1, x0:x1] = cv2.resize(f[y0 * k:y1 * k, x0 * k:x1 * k], (x1 - x0, y1 - y0), interpolation=cv2.INTER_AREA)
+        return self.buf
+
+    def self_check(self, f):
+        if self.fast:
+            y0, y1, x0, x1 = self.roi
+            if not np.array_equal(self.full(f)[y0:y1, x0:x1], self(f)[y0:y1, x0:x1]):
+                self.fast = False
+                print("note: ROI-only resize is not bit-identical on this OpenCV build -> using the full resize")
+        return self.fast
+
+
+class _Prefetch:
+    """Reads frames on a background thread (cv2 releases the GIL inside read()).  Same frames, same order, nothing is dropped: the queue
+    is bounded and the reader BLOCKS when it is full.  get() returns None at end of stream."""
+
+    def __init__(self, cap, depth=6):
+        self.cap, self.q, self.stop, self.err = cap, queue.Queue(depth), threading.Event(), None
+        self.t = threading.Thread(target=self._run, name="lane-reader", daemon=True)
+        self.t.start()
+
+    def _put(self, item):
+        while not self.stop.is_set():
+            try:
+                self.q.put(item, timeout=0.1)
+                return True
+            except queue.Full:
+                pass
+        return False
+
+    def _run(self):
+        try:
+            while not self.stop.is_set():
+                ok, f = self.cap.read()
+                if not ok or not self._put(f):
+                    break
+        except BaseException as e:           # surfaced in get()
+            self.err = e
+        finally:
+            self._put(None)
+
+    def get(self):
+        item = self.q.get()
+        if item is None and self.err is not None:
+            raise self.err
+        return item
+
+    def close(self):                          # call BEFORE cap.release()
+        self.stop.set()
+        try:
+            while True:
+                self.q.get_nowait()
+        except queue.Empty:
+            pass
+        self.t.join()
+
+
+class _AsyncWriter:
+    """cv2.VideoWriter.write on a background thread.  Frames are written in order, none dropped (bounded queue, producer blocks if full).
+    close() flushes everything; call it BEFORE vw.release().  The caller must not modify a frame after write()."""
+
+    def __init__(self, vw, depth=8):
+        self.vw, self.q, self.err = vw, queue.Queue(depth), None
+        self.t = threading.Thread(target=self._run, name="lane-writer", daemon=True)
+        self.t.start()
+
+    def _run(self):
+        while True:
+            fr = self.q.get()
+            if fr is None:
+                return
+            if self.err is None:
+                try:
+                    self.vw.write(fr)
+                except BaseException as e:
+                    self.err = e
+
+    def write(self, fr):
+        if self.err is not None:
+            raise self.err
+        self.q.put(fr)
+
+    def close(self):
+        self.q.put(None)
+        self.t.join()
+        if self.err is not None:
+            raise self.err
+
