+def _blend_fill(img, poly, color):
+    """PERF.  Pixel-identical to   ov = img.copy(); cv2.fillPoly(ov, [poly], color); img = cv2.addWeighted(ov, 0.30, img, 0.70, 0)
+    but works only inside the polygon's bounding rectangle (outside it ov == img, and addWeighted(x, .3, x, .7) == x for every uint8
+    value, so those pixels are unchanged anyway).  Modifies img IN PLACE and returns it (draw() already drew into its argument)."""
+    H, W = img.shape[:2]
+    x, y, w, h = cv2.boundingRect(poly)
+    x0, y0, x1, y1 = max(x, 0), max(y, 0), min(x + w, W), min(y + h, H)
+    if x1 <= x0 or y1 <= y0:
+        return img
+    sub = img[y0:y1, x0:x1]
+    ov = sub.copy()
+    cv2.fillPoly(ov, [poly], color, offset=(-x0, -y0))
+    cv2.addWeighted(ov, 0.30, sub, 0.70, 0, dst=sub)
+    return img
